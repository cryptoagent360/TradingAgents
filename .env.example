# LLM Providers (set the one you use).
# ANTHROPIC_API_KEY is OPTIONAL for the Solana bot — the AI filter is opt-in
# at the runner level and skipped by default. Set it only if you wire the
# filter into run_paper(...) yourself (or use the LangGraph agent stack).
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# Solana bot trading mode. "paper" runs simulated fills (safe); "live" is
# refused until LiveEngine is fully wired into the runner. Default: paper.
TRADING_MODE=paper

# Solana bot — backtesting and paper trading need no keys (public market data only).
# Live execution lands in a follow-up PR; the variables below will be wired then.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# SOLANA_BOT_LIVE=         # set to "1" to opt in to live execution once available

# Kraken (alternate live exchange — wiring lands with the LiveEngine completion PR).
# Trade-only key. NEVER enable withdraw or transfer permissions on this key.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Telegram alerts (kill switch trips, ReconcileMismatch, optional trade events).
# Leave both blank to disable. Talk to @BotFather to mint a bot token; the chat
# ID is your numeric Telegram user/channel id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
